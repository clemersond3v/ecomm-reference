{
  "name": "ecomm-reference",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "dev:compose": "docker compose -f infra/docker/docker-compose.yml up --build",
    "down:compose": "docker compose -f infra/docker/docker-compose.yml down -v"
  },
  "pnpm": {
    "overrides": {
      "typescript": "5.4.5"
    }
  }
}
